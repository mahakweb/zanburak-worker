APP_NAME=zanburak-worker
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MUST match zanburak-backend (shared PostgreSQL — not MySQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zanburak
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
DB_SEARCH_PATH=public

CACHE_DRIVER=file
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_RETRY_AFTER=7500

# Shared with zanburak-backend
UPLOAD_TOKEN_SECRET=

FFMPEG_BINARIES=
FFPROBE_BINARIES=
VIDEO_ENCODER=auto
VIDEO_NVENC_PRESET=p4
VIDEO_X264_PRESET=veryfast
VIDEO_DOWNLOAD_CONCURRENCY=2
VIDEO_GENERATE_DOWNLOADS=false
VIDEO_FULL_STREAM_LADDER=false
VIDEO_STREAM_LADDER=720

STATIC_HOST=
STATIC_USERNAME=
STATIC_PASSWORD=
STATIC_URL=https://static.zanburak.ir
STATIC_ROOT=/public_html
STATIC_FTP_TIMEOUT=600
VIDEO_DISK=dl
MEDIA_ROOT=D:/zanburak-media
DL_HOST=185.252.28.150
DL_USERNAME=dlmahakw
DL_PASSWORD=
DL_ROOT=/public_html
DL_URL=https://dl.zanburak.ir
FONT_TTF_FOR_WATERMARK=C:/Windows/Fonts/tahoma.ttf
STATIC_DEPLOY_SECRET=
